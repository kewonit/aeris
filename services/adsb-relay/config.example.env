# Generic example only. Do not commit production values or provider terms.
RELAY_LISTEN_ADDR=:8080
RELAY_DATA_DIR=./data

# Authorized local or private readsb aircraft.json endpoint.
RELAY_READSB_URL=
RELAY_PROVIDER_ID=
RELAY_PROVIDER_LABEL=
RELAY_ATTRIBUTION_URL=

# Exact browser origins, comma-separated.
RELAY_ALLOWED_ORIGINS=http://localhost:3000

# Base64url-encoded Ed25519 public key used to verify one-use stream tickets.
RELAY_TICKET_PUBLIC_KEY=

# Server-to-server bearer token for bounded HTTP data endpoints.
RELAY_HTTP_TOKEN=

# Optional operational limits. Keep production values in private deployment
# configuration rather than in this repository.
RELAY_MAX_HISTORY_BYTES=
RELAY_MAX_CONNECTIONS=
RELAY_MAX_RESPONSE_AIRCRAFT=
